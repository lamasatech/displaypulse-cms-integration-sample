<?xml version="1.0" encoding="utf-8"?>
<!--
    The DisplayPulse app's local API is plain HTTP on this device, so cleartext is allowed to
    127.0.0.1 and localhost only, and nowhere else. SameDeviceOnlyInterceptor also refuses any
    connection that resolves to another address before the request is sent.
    Only the system's certificate authorities are trusted, never ones the user added.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
